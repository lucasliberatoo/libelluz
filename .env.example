# Copie para .env.local (nunca comite o .env.local) e preencha.

# Banco: Neon em produção, PGlite local (ex.: pglite:./.pglite)
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# e-mail que entra como admin sem convite
ADMIN_EMAIL=

# Fotos e arquivos (Cloudflare R2) — opcional
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- Notificações ----
# Par de chaves VAPID do Web Push. Gere com:
#   npx web-push generate-vapid-keys
# A pública vai para o navegador (por isso NEXT_PUBLIC_); a privada é SEGREDO:
# só em variável de ambiente, nunca no git.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# contato exigido pelo padrão VAPID (mailto: ou https://)
VAPID_SUBJECT=
# segredo do cron (.github/workflows/notificacoes.yml manda no header authorization)
CRON_SECRET=
# URL pública do site, usada pelo workflow do GitHub (secret LIBELLUZ_URL)
LIBELLUZ_URL=
