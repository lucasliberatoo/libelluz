<?xml version="1.0" encoding="utf-8"?>
<!-- Juntado ao manifest do app pelo manifest merger do Gradle. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Saber qual app está na frente (Configurações > Acesso ao uso). Não usamos AccessibilityService de propósito:
         o Play Protect bloqueia a instalação, por fora da loja, de apps que pedem acessibilidade. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Mostrar a tela do token por cima do app bloqueado (Configurações > Sobrepor a outros apps). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Serviço em primeiro plano com a notificação discreta "Modo Disciplina ativo". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Religar o modo depois de reiniciar o celular ou atualizar o app. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Bloquear as notificações dos apps escolhidos (Configurações > Acesso a notificações). -->
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        tools:ignore="ProtectedPermissions" />
    <!-- Pedir para o Android não matar o serviço para economizar bateria (opcional). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 11+: listar os apps com ícone na tela inicial (sem QUERY_ALL_PACKAGES). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <service
            android:name="app.libelluz.appblocker.BlockerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Bloqueio dos apps escolhidos pela pessoa (Modo Disciplina): detecta o app em primeiro plano e mostra a tela do token." />
        </service>

        <service
            android:name="app.libelluz.appblocker.NotifBlockerService"
            android:exported="false"
            android:label="Libelluz · Modo Disciplina"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name="app.libelluz.appblocker.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
